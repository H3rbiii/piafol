RewriteEngine On

# Keep one canonical HTTPS, non-www URL for the public site.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.piafol\.pl$ [NC]
RewriteRule ^ https://piafol.pl%{REQUEST_URI} [R=301,L,NE]

RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ https://piafol.pl/ [R=301,L]

<FilesMatch "^(contact-config\.php|contact-config\.example\.php)$">
    Require all denied
</FilesMatch>
